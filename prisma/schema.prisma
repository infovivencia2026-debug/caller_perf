generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TELECALLER
}

enum CustomerStatus {
  NEW
  IN_PROGRESS
  INTERESTED
  NOT_INTERESTED
  CALLBACK
  MEETING_SCHEDULED
  CLOSED
  INVALID
}

enum CallStatus {
  INTERESTED
  NOT_INTERESTED
  NO_ANSWER
  BUSY
  SWITCHED_OFF
  WRONG_NUMBER
  CALLBACK_REQUESTED
  MEETING_SCHEDULED
  EXISTING_CUSTOMER
  SALE_CLOSED
  INVALID_NUMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(TELECALLER)
  active       Boolean   @default(true)
  // Bumped whenever the password changes; a session carries the version it was issued
  // with, so old sessions (and thus the old password's logins) stop being valid.
  tokenVersion Int       @default(0)
  dailyTarget  Int       @default(50)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customers   Customer[]   @relation("AssignedCustomers")
  calls       Call[]
  followUps   FollowUp[]
  activities  ActivityLog[]
  attendance  Attendance[]
  callEdits   CallEdit[]
}

/** One row per telecaller per day they were present (marked or derived from a call). */
model Attendance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

model Customer {
  id        String         @id @default(cuid())
  // Phone is the only required field and the natural key; name and the rest are
  // optional. An unnamed customer is shown by phone number (see customerLabel).
  name      String         @default("")
  phone     String         @unique
  company   String?
  email     String?
  city      String?
  notes     String?
  status    CustomerStatus @default(NEW)
  priority  Priority       @default(MEDIUM)
  // Tags are stored comma-separated rather than as a native array, so the same code
  // works on any provider. Read and write them via src/lib/tags.ts.
  tags      String         @default("")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  assignedToId String?
  assignedTo   User?   @relation("AssignedCustomers", fields: [assignedToId], references: [id], onDelete: SetNull)

  calls     Call[]
  followUps FollowUp[]

  @@index([assignedToId, status])
  @@index([status])
  @@index([name])
}

model Call {
  id String @id @default(cuid())
  // Optional, and SetNull rather than Cascade: an invalid number is deleted outright
  // (see deleteInvalidLead), but the work still happened — the call stays, so the
  // counsellor keeps credit for it and past performance numbers do not move.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Who was called, captured at the time. This is the only record of them once the
  // lead is deleted, so every read falls back to it (see callLead).
  customerPhone String  @default("")
  customerName  String?
  callerId      String
  caller        User       @relation(fields: [callerId], references: [id], onDelete: Cascade)
  status        CallStatus
  response      String?
  comments      String?
  course        String? // course the interested lead was tagged with
  startedAt     DateTime
  endedAt       DateTime
  duration      Int // seconds
  createdAt     DateTime   @default(now())

  followUp FollowUp?
  edits    CallEdit[]

  @@index([callerId, startedAt])
  @@index([customerId, startedAt])
  @@index([startedAt])
}

/**
 * One row per correction made to a logged call. Counsellors can edit their own call
 * history, so the before-value has to survive somewhere or the numbers stop being
 * defensible — this is that trail. Append-only; nothing in the app updates or
 * deletes these.
 */
model CallEdit {
  id     String @id @default(cuid())
  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  // Who made the edit. Kept even if they leave, hence SetNull rather than Cascade.
  editorId String?
  editor   User?   @relation(fields: [editorId], references: [id], onDelete: SetNull)

  fromStatus   CallStatus
  toStatus     CallStatus
  fromResponse String?
  toResponse   String?
  fromComments String?
  toComments   String?
  fromCourse   String?
  toCourse     String?

  createdAt DateTime @default(now())

  @@index([callId, createdAt])
  @@index([editorId, createdAt])
}

model FollowUp {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  callerId   String
  caller     User           @relation(fields: [callerId], references: [id], onDelete: Cascade)
  callId     String?        @unique
  call       Call?          @relation(fields: [callId], references: [id], onDelete: SetNull)
  dueAt      DateTime
  priority   Priority       @default(MEDIUM)
  status     FollowUpStatus @default(PENDING)
  notes      String?
  completedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([callerId, status, dueAt])
  @@index([dueAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
