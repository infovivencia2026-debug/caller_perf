generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TELECALLER
}

enum CustomerStatus {
  NEW
  IN_PROGRESS
  NO_ANSWER
  BUSY
  INTERESTED
  NOT_INTERESTED
  CALLBACK
  MEETING_SCHEDULED
  CLOSED
  INVALID
}

enum CallStatus {
  INTERESTED
  NOT_INTERESTED
  NO_ANSWER
  BUSY
  SWITCHED_OFF
  OUT_OF_SERVICE
  DISCONNECTED
  WRONG_NUMBER
  CALLBACK_REQUESTED
  MEETING_SCHEDULED
  EXISTING_CUSTOMER
  SALE_CLOSED
  INVALID_NUMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(TELECALLER)
  active       Boolean   @default(true)
  // Bumped whenever the password changes; a session carries the version it was issued
  // with, so old sessions (and thus the old password's logins) stop being valid.
  tokenVersion Int       @default(0)
  dailyTarget  Int       @default(50)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customers   Customer[]   @relation("AssignedCustomers")
  calls       Call[]
  followUps   FollowUp[]
  activities  ActivityLog[]
  attendance  Attendance[]
  callEdits   CallEdit[]
  uploadedLists ImportList[] @relation("UploadedLists")
}

/** One row per telecaller per day they were present (marked or derived from a call). */
model Attendance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

/**
 * One uploaded file. Every customer imported from it belongs to it, so a list can be
 * browsed, assigned and reported on as a unit — "the August walk-ins", "the Hyderabad
 * batch" — instead of dissolving into one undifferentiated pool of 150,000 rows.
 *
 * Deleting a list leaves its customers in place (SetNull); emptying the file cabinet
 * should not shred the leads.
 */
model ImportList {
  id       String @id @default(cuid())
  /** The uploaded file's name, which is what an admin recognises it by. */
  name     String
  /** Free text — where the leads came from, which campaign, anything worth knowing. */
  note     String?
  /** Row counts at import time; the live totals are counted from Customer. */
  rowsImported  Int @default(0)
  rowsDuplicate Int @default(0)
  rowsInvalid   Int @default(0)

  uploadedById String?
  uploadedBy   User?   @relation("UploadedLists", fields: [uploadedById], references: [id], onDelete: SetNull)

  /** Leads whose *origin* was this file — the first upload that introduced them. */
  customers Customer[]
  /** Every lead this file contained, including ones an earlier file had already
      introduced. This is the file's identity: exactly what was in it. */
  members   ListMembership[]
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/**
 * A lead appearing in an uploaded file.
 *
 * Phone is unique across the app, so a number that arrives in a second file is not
 * imported again — but it *was* in that file, and the file's contents have to say so.
 * Without this, a list would silently under-report itself, and assigning "from this
 * file" would skip leads that were genuinely in it.
 */
model ListMembership {
  id         String     @id @default(cuid())
  listId     String
  list       ImportList @relation(fields: [listId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /** True when this file is where the lead came from, rather than a later re-appearance. */
  isOrigin   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@unique([listId, customerId])
  @@index([customerId])
}

model Customer {
  id        String         @id @default(cuid())
  // Phone is the only required field and the natural key; name and the rest are
  // optional. An unnamed customer is shown by phone number (see customerLabel).
  name      String         @default("")
  phone     String         @unique
  company   String?
  email     String?
  city      String?
  notes     String?
  status    CustomerStatus @default(NEW)
  priority  Priority       @default(MEDIUM)
  // Tags are stored comma-separated rather than as a native array, so the same code
  // works on any provider. Read and write them via src/lib/tags.ts.
  tags      String         @default("")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  assignedToId String?
  assignedTo   User?   @relation("AssignedCustomers", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Which upload this lead came from. Null for leads added by hand on the calling
  // screen, which belong to no file.
  listId String?
  list   ImportList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  calls       Call[]
  followUps   FollowUp[]
  memberships ListMembership[]

  @@index([assignedToId, status])
  @@index([status])
  @@index([name])
  @@index([listId, assignedToId])
}

model Call {
  id String @id @default(cuid())
  // Optional, and SetNull rather than Cascade: an invalid number is deleted outright
  // (see deleteInvalidLead), but the work still happened — the call stays, so the
  // counsellor keeps credit for it and past performance numbers do not move.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Who was called, captured at the time. This is the only record of them once the
  // lead is deleted, so every read falls back to it (see callLead).
  customerPhone String  @default("")
  customerName  String?
  callerId      String
  caller        User       @relation(fields: [callerId], references: [id], onDelete: Cascade)
  status        CallStatus
  response      String?
  comments      String?
  course        String? // course the interested lead was tagged with
  startedAt     DateTime
  endedAt       DateTime
  duration      Int // seconds
  createdAt     DateTime   @default(now())

  followUp FollowUp?
  edits    CallEdit[]

  @@index([callerId, startedAt])
  @@index([customerId, startedAt])
  @@index([startedAt])
}

/**
 * One row per correction made to a logged call. Counsellors can edit their own call
 * history, so the before-value has to survive somewhere or the numbers stop being
 * defensible — this is that trail. Append-only; nothing in the app updates or
 * deletes these.
 */
model CallEdit {
  id     String @id @default(cuid())
  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  // Who made the edit. Kept even if they leave, hence SetNull rather than Cascade.
  editorId String?
  editor   User?   @relation(fields: [editorId], references: [id], onDelete: SetNull)

  fromStatus   CallStatus
  toStatus     CallStatus
  fromResponse String?
  toResponse   String?
  fromComments String?
  toComments   String?
  fromCourse   String?
  toCourse     String?

  createdAt DateTime @default(now())

  @@index([callId, createdAt])
  @@index([editorId, createdAt])
}

model FollowUp {
  id         String         @id @default(cuid())
  // Nullable + SetNull so deleting a lead never wipes its callback. The phone/name/status
  // below are snapshotted at creation, so the callback stays visible and dialable even
  // after the customer row is gone (shown as "lead deleted").
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Snapshot of the lead, preserved if the customer is later deleted.
  customerPhone  String  @default("")
  customerName   String?
  customerStatus String?
  callerId   String
  caller     User           @relation(fields: [callerId], references: [id], onDelete: Cascade)
  callId     String?        @unique
  call       Call?          @relation(fields: [callId], references: [id], onDelete: SetNull)
  dueAt      DateTime
  priority   Priority       @default(MEDIUM)
  status     FollowUpStatus @default(PENDING)
  notes      String?
  completedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([callerId, status, dueAt])
  @@index([dueAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
