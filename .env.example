# Postgres connection used by the app at runtime. On Neon/Supabase use the POOLED url.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: direct (non-pooled) url. Prisma Migrate uses this when set, because
# connection poolers reject some of the statements migrations issue.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the session cookie. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="generate-a-long-random-string"

# Optional: password given to the seeded accounts. Always set this when seeding
# anything other than a throwaway local database.
SEED_PASSWORD=""
